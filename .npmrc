# Supply-chain guardrails (npm >= 11.10).
# Recent npm compromises (axios 1.14.1/0.30.4, the Shai-Hulud/ChainDrop worms) shipped
# payloads in install scripts and were pulled from the registry within hours to days.
# No package in this tree needs an install script.
ignore-scripts=true
# Only resolve versions that have been public for at least 14 days.
min-release-age=14
# Dependencies come from the registry only, never from git URLs.
allow-git=none
engine-strict=true
# Security fixes reviewed by hand (tarball diffed against the previous release, same publisher,
# no new dependencies or scripts) and pinned exactly via "overrides" in package.json. Drop
# each line, and its override, once the version is older than min-release-age:
#   follow-redirects 1.16.2 (2026-10-25, GHSA-mrwp-f3q8-3g9p)                 -> 2026-11-08
#   fast-uri 3.1.9 (2026-10-19, GHSA-w74x-v6f9-j3xg, GHSA-wjr9-j795-jxcr, ...) -> 2026-11-02
min-release-age-exclude[]=follow-redirects
min-release-age-exclude[]=fast-uri
