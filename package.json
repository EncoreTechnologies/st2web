{
  "name": "st2web",
  "version": "2.4.3",
  "st2_version": "3.10dev",
  "private": true,
  "scripts": {
    "develop": "rsbuild dev",
    "serve-dev": "rsbuild dev",
    "build": "rsbuild build",
    "serve": "rsbuild preview",
    "serve-prod": "rsbuild preview",
    "clean": "rm -rf build",
    "eslint": "eslint .",
    "lint": "eslint .",
    "test": "npm run lint && npm run test-unit",
    "test-unit": "rstest run",
    "test-functional": "playwright test"
  },
  "repository": "stackstorm/st2web",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "modules/*"
  ],
  "dependencies": {
    "@stackstorm/app-actions": "*",
    "@stackstorm/app-code": "*",
    "@stackstorm/app-history": "*",
    "@stackstorm/app-inquiry": "*",
    "@stackstorm/app-packs": "*",
    "@stackstorm/app-rules": "*",
    "@stackstorm/app-triggers": "*",
    "@stackstorm/app-workflows": "*",
    "@stackstorm/module-router": "*",
    "@stackstorm/module-store": "*",
    "@stackstorm/st2-style": "*",
    "lodash": "4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rsbuild/core": "2.2.13",
    "@rsbuild/plugin-react": "2.1.1",
    "@rstest/adapter-rsbuild": "0.12.3",
    "@rstest/core": "0.12.3",
    "@rstest/coverage-istanbul": "0.12.3",
    "@stackstorm/module-test-utils": "*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "axios-mock-adapter": "2.1.0",
    "chai": "6.3.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.30",
    "postcss-import": "17.0.1",
    "postcss-nested": "9.0.0",
    "postcss-preset-env": "11.6.1",
    "sinon": "22.1.0",
    "sinon-chai": "4.0.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2"
  }
}
