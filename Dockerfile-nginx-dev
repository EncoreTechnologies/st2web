FROM node:24-alpine AS build

WORKDIR /opt/stackstorm/static/webui/st2web

# git stamps the commit into package.meta
RUN apk add --no-cache git

COPY package.json package-lock.json ./
COPY apps ./apps
COPY modules ./modules
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

FROM nginx
RUN rm -f /etc/nginx/conf.d/default.conf
COPY ./nginx.local-dev.conf /etc/nginx/conf.d/st2.conf
COPY --from=build /opt/stackstorm/static/webui/st2web/build /opt/stackstorm/static/webui
